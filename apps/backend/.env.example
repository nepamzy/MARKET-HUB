# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://markethub:markethub_dev_password@localhost:5432/markethub_dev?schema=public"

# Access token signing secret — generate a strong random value, e.g.
# `openssl rand -hex 32`. Refresh tokens are opaque random values stored
# hashed in the database (not JWTs), so there is no separate refresh secret.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# Optional bootstrap platform admin, only used by `npm run prisma:seed`.
# Leave unset to skip creating a seed admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Platform Admin"

# Phase 10 — Payments (Paystack). Both optional: leave unset to run every
# other feature without a payment provider configured. Initiating a
# payment or verifying a webhook without PAYSTACK_SECRET_KEY set fails with
# an explicit "payment provider is not configured" error — it never falls
# back to a fake success. Get a real test secret key from a Paystack
# dashboard (https://dashboard.paystack.com/#/settings/developers) to
# exercise the real flow locally; never commit a real key here.
PAYSTACK_SECRET_KEY=
# Where Paystack redirects the buyer's browser after the hosted checkout
# page, e.g. http://localhost:3000/payments/callback. A UX redirect only —
# never treated as proof of payment.
PAYSTACK_CALLBACK_URL=

// MARKET HUB — Phase A data foundation.
// Domains covered: identity (User, RefreshToken), organizations
// (Organization, OrganizationMembership), and a minimal AuditLog for
// security-relevant actions. See docs/DATABASE.md for rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_ADMIN
  CUSTOMER
  DRIVER
}

enum BusinessType {
  PRODUCER_MANUFACTURER
  WHOLESALER
  RETAILER
  DIRECT_BUSINESS
  LOGISTICS_COMPANY
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PermissionResource {
  ORDERS
  INVENTORY
  PROCUREMENT
  PAYMENTS
  CATALOGUE
  CUSTOMERS
  KYC
  MEMBERS
  SETTINGS
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  platformRole  PlatformRole  @default(CUSTOMER)
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships        OrganizationMembership[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]               @relation("ActorAuditLogs")
  grantedPermissions MembershipPermission[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  family            String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  userAgent         String?

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Organization {
  id                 String              @id @default(uuid())
  legalName          String
  businessType       BusinessType
  status             OrganizationStatus  @default(ACTIVE)
  verificationStatus VerificationStatus  @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  memberships OrganizationMembership[]
  auditLogs   AuditLog[]                @relation("OrganizationAuditLogs")

  @@index([businessType])
  @@map("organizations")
}

model OrganizationMembership {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  permissions MembershipPermission[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Business-scoped, per-resource permission overrides layered on top of
/// MembershipRole (Phase 0.1 — see docs/handoff/PHASE_0_MASTER_BLUEPRINT.md
/// §6.1). A row here only needs to exist when an owner overrides the
/// resource's role default (packages/shared DEFAULT_PERMISSIONS); absence
/// of a row means "use the default for this member's role." OWNER-role
/// memberships never have rows here — ownership is never a partial or
/// overridable access level, enforced in the service layer, not the schema.
model MembershipPermission {
  id              String                  @id @default(uuid())
  membershipId    String
  membership      OrganizationMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  resource        PermissionResource
  level           PermissionLevel
  grantedByUserId String
  grantedBy       User                    @relation(fields: [grantedByUserId], references: [id], onDelete: Restrict)
  updatedAt       DateTime                @updatedAt

  @@unique([membershipId, resource])
  @@index([membershipId])
  @@map("membership_permissions")
}

/// Audit trail for security-relevant and administrative actions
/// (Architecture Principles: "important financial, security and
/// administrative actions should have an audit trail"). Deliberately
/// minimal — not a general-purpose event log.
model AuditLog {
  id             String        @id @default(uuid())
  actorUserId    String?
  actor          User?         @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation("OrganizationAuditLogs", fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}
